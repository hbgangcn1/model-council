# --- model-council specific ---

# User data: NEVER commit live runtime writes (balances, telemetry, runs).
# Policy since v15.9: the repo SHIPS a sanitized starter snapshot
# (capabilities.json + benchmark/golden/golden-set.json, generated by
# scripts/sanitize_snapshot.py); local bench ingests / self-evolve applies /
# balances on top must not be committed back. The negations below keep the
# starter snapshot tracked while ignoring live files of the same name.
#
# Exception: tests/fixtures/*.json ARE committed (they are minimal test data,
# not real production data).
capabilities.json
capabilities.*.bak
capabilities.rev*.json.bak
balance-snapshot.json
circuit-state.json
elo.json
cost-drift.json
cost-reconcile-events.jsonl
judge-drift.json
judge-drift-events.jsonl
guardrail-events.jsonl
exchange-rates.json
exchange-rates-history.jsonl
token-profiles.json
bench-progress.json
auto-evolve-*.json
auto-evolve-*.log
auto-evolve-events.jsonl
runtime-feedback.jsonl
pending-runtime-diff.json
pending-runtime-diff.*.json

# Top-level JSON files for pytest (committed as minimal fixtures):
!capabilities.json
!pricing-profiles.json

# User runs: produced by `python -m orchestrator.council_v14 --task ...`
# Default location is outside this repo (in user's data dir),
# but if user runs in-repo, exclude local runs
runs/

# User-applied benchmark results
benchmark/responses/
benchmark/scores/
benchmark/results/
benchmark/applied/
benchmark/longctx-content/
benchmark/longctx-content/

# Legacy directories
archive/
.legacy/
scratch/
ledger/
evidence/
reports/
tools/
benchmarks/

# Secrets (should never be committed, defensive)
*.token
*.opencode_key
.credentials.yaml
.env
.env.local
*.key
*.pem
secrets/

